:root{--ink:#2b2438;--soft:#5c5470;--plum:#5d4a7e;--plum-d:#473862;--wist:#8d76b0;--lilac:#d9cfe8;--petal:#ece4f4;--mist:#f5f1f9;--paper:#fcfaff;--sage:#7d9a82;--sage-d:#4f6e55;--line:#ddd3ea;--r:14px}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:5.5rem}
body{margin:0;font-family:'Oldenburg',Georgia,serif;font-size:1.05rem;line-height:1.7;color:var(--ink);background:var(--paper)}
h1,h2,h3{font-family:'Parisienne','Oldenburg',cursive;font-weight:400;line-height:1.15;color:var(--plum);margin:0 0 .5em;letter-spacing:.01em}
h1{font-size:clamp(3.1rem,8vw,5.2rem)}h2{font-size:clamp(2.3rem,5vw,3.1rem)}h3{font-size:1.95rem}
p{margin:0 0 1em;max-width:68ch}a{color:var(--plum-d);text-underline-offset:3px}a:hover{color:var(--sage-d)}
:focus-visible{outline:3px solid var(--sage);outline-offset:3px;border-radius:4px}
.wrap{max-width:1080px;margin:0 auto;padding:0 1.25rem}
.skip{position:absolute;left:-999px}.skip:focus{left:1rem;top:1rem;background:#fff;padding:.5rem 1rem;z-index:99}
header.top{position:sticky;top:0;z-index:50;background:rgba(252,250,255,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;gap:1rem;min-height:4.2rem}
.logo{font-family:'Parisienne',cursive;font-size:2.4rem;color:var(--plum);text-decoration:none;line-height:1;margin-right:auto}
nav#nav ul{display:flex;gap:1.1rem;list-style:none;margin:0;padding:0}
nav#nav a{text-decoration:none;color:var(--ink);padding:.3rem 0;border-bottom:2px solid transparent;font-size:.98rem}
nav#nav a:hover,nav#nav a[aria-current]{border-color:var(--sage)}
.lang{display:flex;border:1px solid var(--line);border-radius:99px;overflow:hidden;font-size:.9rem}
.lang a,.lang span{padding:.2rem .7rem;text-decoration:none}.lang span{background:var(--plum);color:#fff}
.burger{display:none;background:none;border:1px solid var(--line);border-radius:8px;padding:.45rem .7rem;font:inherit;color:var(--plum);cursor:pointer}
@media(max-width:1000px){.burger{display:block}nav#nav{display:none;position:absolute;left:0;right:0;top:100%;background:var(--paper);border-bottom:1px solid var(--line);padding:.5rem 1.25rem 1rem}nav#nav.open{display:block}nav#nav ul{flex-direction:column;gap:.2rem}nav#nav a{display:block;padding:.55rem 0}}
.btn{display:inline-block;font:inherit;background:var(--plum);color:#fff;border:2px solid var(--plum);border-radius:99px;padding:.6rem 1.5rem;text-decoration:none;cursor:pointer;transition:background .2s}
.btn:hover{background:var(--plum-d);color:#fff}.btn.ghost{background:transparent;color:var(--plum)}.btn.ghost:hover{background:var(--petal);color:var(--plum-d)}
.btns{display:flex;flex-wrap:wrap;gap:.8rem;margin-top:1.4rem}
.hero{position:relative;overflow:hidden;background:linear-gradient(180deg,var(--petal),var(--paper) 92%);padding:clamp(8.5rem,21vw,24rem) 0 4.5rem}
.hero .rac{position:absolute;top:0;left:0;width:100%;height:auto;pointer-events:none}
.sway{animation:sway 9s ease-in-out infinite alternate}
@keyframes sway{from{transform:rotate(-1.2deg)}to{transform:rotate(1.2deg)}}
.hero .wrap{position:relative}.hero p.lead{font-size:1.2rem;max-width:56ch}
.pagehead{background:linear-gradient(180deg,var(--petal),var(--paper));padding:3.2rem 0 1.5rem;border-bottom:1px solid var(--line)}
section{padding:3.5rem 0}section.alt{background:var(--mist)}
.three{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}.two{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem}
@media(max-width:820px){.three,.two{grid-template-columns:1fr;gap:1.5rem}}
.path{border-top:3px solid var(--sage);padding-top:1rem}.path:nth-child(2){border-color:var(--wist)}.path:nth-child(3){border-color:var(--lilac)}
dl.diff{margin:0}dl.diff>div{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:.3rem 2.5rem;padding:1rem 0;border-top:1px solid var(--line)}dl.diff dt{font-weight:700;color:var(--plum)}dl.diff dd{margin:0}
@media(max-width:700px){dl.diff>div{grid-template-columns:1fr}}
ul.plain{padding-left:1.2rem}ul.plain li{margin-bottom:.4rem}ul.plain li::marker{color:var(--sage)}
.offer{padding:1.6rem 0;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 2fr;gap:1rem 2.5rem}.offer h3{margin:0}
@media(max-width:760px){.offer{grid-template-columns:1fr}}
table{border-collapse:collapse;width:100%;margin:1rem 0 2rem}th,td{text-align:left;padding:.8rem .6rem;border-bottom:1px solid var(--line);vertical-align:top}th{color:var(--plum);border-bottom:2px solid var(--wist)}
.tw{overflow-x:auto}
.person{background:var(--mist);border-radius:var(--r);padding:1.4rem}
.note{border-left:4px solid var(--sage);background:var(--mist);padding:.9rem 1.2rem;border-radius:0 var(--r) var(--r) 0;margin:1.2rem 0;max-width:72ch}
.f{display:grid;gap:1rem;max-width:620px;margin-top:1.2rem}.f label{display:grid;gap:.25rem;font-size:.97rem}
.f input,.f select,.f textarea{font:inherit;padding:.65rem .8rem;border:1px solid #bfb2d3;border-radius:10px;background:#fff;color:var(--ink);width:100%}
.f textarea{min-height:7rem}.f .chk{display:flex;gap:.6rem;align-items:flex-start}.f .chk input{width:auto;margin-top:.45rem}
.hp{position:absolute;left:-9999px}.msg{min-height:1.4em;margin:0}.msg.ok{color:var(--sage-d)}.msg.bad{color:#9b2c4a}
.map{background:var(--petal);border-radius:var(--r);min-height:320px;display:grid;place-items:center;overflow:hidden;margin:1rem 0}.map iframe{width:100%;height:380px;border:0}
.faq details{border-top:1px solid var(--line);padding:.9rem 0}.faq summary{cursor:pointer;color:var(--plum);font-weight:700}
footer{background:var(--plum-d);color:#efe9f6;padding:3rem 0 2rem;margin-top:2rem}footer a{color:#efe9f6}footer h3{color:#fff;font-size:1.6rem}
footer .three{gap:1.5rem}footer ul{list-style:none;padding:0;margin:0}footer small{display:block;margin-top:2rem;opacity:.85}
.linkbtn{background:none;border:0;color:inherit;font:inherit;text-decoration:underline;cursor:pointer;padding:0}
.cc{position:fixed;left:1rem;right:1rem;bottom:1rem;max-width:640px;background:#fff;border:1px solid var(--wist);border-radius:var(--r);padding:1rem 1.2rem;z-index:80;box-shadow:0 8px 30px rgba(60,40,90,.18)}.cc[hidden]{display:none}.cc p{margin:0 0 .8rem;font-size:.95rem}.cc .btn{padding:.4rem 1.1rem}
.hltoggle{position:fixed;right:.8rem;bottom:.8rem;z-index:70;font:.8rem sans-serif;background:#222;color:#fff;border:0;border-radius:8px;padding:.45rem .7rem;opacity:.85;cursor:pointer}
mark.ph{background:#ffe27a;color:#3a2f00;outline:1px dashed #b38f00;padding:0 .25em;border-radius:3px}
mark.inf{background:#c9e4ff;color:#10304f;outline:1px dashed #3b78b5;padding:0 .2em;border-radius:3px}
.ph-link{outline:2px dashed #b38f00;outline-offset:3px}
body.clean mark.ph,body.clean mark.inf{background:none;color:inherit;outline:0;padding:0}body.clean .ph-link{outline:0}
@media(prefers-reduced-motion:reduce){.sway{animation:none}html{scroll-behavior:auto}}
@media print{header.top,.cc,.hltoggle{display:none}}
.styles h3{font-size:1.7rem;margin-bottom:.2em}.styles{row-gap:1.4rem}
ol.steps{list-style:none;counter-reset:s;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
ol.steps li{counter-increment:s;border-top:3px solid var(--sage);padding-top:1rem}ol.steps li::before{content:counter(s);font-family:'Parisienne',cursive;font-size:2.6rem;color:var(--sage-d);line-height:1}
@media(max-width:820px){ol.steps{grid-template-columns:1fr}}
.band{text-align:center;background:linear-gradient(180deg,var(--petal),var(--mist));border-radius:var(--r);padding:2.5rem 1.2rem}

